#!/var/jb/bin/sh
set -e

DAEMON_PLIST="/var/jb/Library/LaunchDaemons/com.n1ck.wifiusaged.plist"
DAEMON_BIN="/var/jb/usr/libexec/wifiusaged"

if [ -f "$DAEMON_PLIST" ]; then
    chown root:wheel "$DAEMON_PLIST" 2>/dev/null || true
    chmod 0644 "$DAEMON_PLIST" 2>/dev/null || true
fi

if [ -f "$DAEMON_BIN" ]; then
    chown root:wheel "$DAEMON_BIN" 2>/dev/null || true
    chmod 0755 "$DAEMON_BIN" 2>/dev/null || true
fi

/var/jb/bin/launchctl bootout system "$DAEMON_PLIST" 2>/dev/null || launchctl bootout system "$DAEMON_PLIST" 2>/dev/null || true
/var/jb/bin/launchctl unload -w "$DAEMON_PLIST" 2>/dev/null || launchctl unload -w "$DAEMON_PLIST" 2>/dev/null || true
killall -9 wifiusaged 2>/dev/null || true

if [ -f "$DAEMON_BIN" ]; then
    "$DAEMON_BIN" --once 2>/dev/null || true
fi

if [ -f "$DAEMON_PLIST" ]; then
    /var/jb/bin/launchctl bootstrap system "$DAEMON_PLIST" 2>/dev/null || \
    launchctl bootstrap system "$DAEMON_PLIST" 2>/dev/null || \
    /var/jb/bin/launchctl load -w "$DAEMON_PLIST" 2>/dev/null || \
    launchctl load -w "$DAEMON_PLIST" 2>/dev/null || true
fi

if [ -f "$DAEMON_BIN" ]; then
    if ! pgrep -x wifiusaged >/dev/null 2>&1; then
        nohup "$DAEMON_BIN" </dev/null >/dev/null 2>&1 &
    fi
fi

exit 0
